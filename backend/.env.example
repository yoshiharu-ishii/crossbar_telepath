# crossbar_telepath の設定サンプル。
#   cp backend/.env.example backend/.env
# して値を埋める。.env はgitignore済み(秘密を含むため絶対にコミットしない)。
# 本番(Fargate)では、秘密は SSM SecureString / Secrets Manager から注入する。
#
# config.py が読む設定はすべてここに並べてある。設定を足すときは両方を更新する。
# ここに書かれた値は config.py の既定値と同じなので、変えない行は消してもよい。

# =====================================================================
# 秘密(絶対にコミットしない)
# =====================================================================
OPENAI_API_KEY=

# =====================================================================
# 動作
# =====================================================================
# シグナリング(SQS)を監視して実通話を拾うか。0ならリプレイ専用
WATCH_CALLS=0
LOG_LEVEL=INFO
# 録音と履歴の置き場。既定は backend/ の隣の recordings/。
# コンテナでもホストでも既定で正しい場所を指すので、通常は設定しない
# RECORDINGS_DIR=

# =====================================================================
# AWS: 通話路(KVS)とシグナリング(SQS)
# =====================================================================
AWS_REGION=ap-northeast-1
# infra/ の var.project と揃える
KVS_STREAM_PREFIX=crossbar-telepath
CALL_EVENTS_QUEUE=crossbar-telepath-call-events
SQS_WAIT_SECONDS=20
# 取り逃した呼を SearchContacts から復元するときだけ要る
CONNECT_INSTANCE_ID=

# =====================================================================
# 文字起こし
#   REALTIME_URL はOpenAI互換のエンドポイントなら差し替えられる
# =====================================================================
REALTIME_URL=wss://api.openai.com/v1/realtime?intent=transcription
TRANSCRIBE_MODEL=gpt-4o-transcribe
TRANSCRIBE_LANGUAGE=ja
# 無音がこの長さ続いたら発話の区切りとみなす(server VAD)
VAD_SILENCE_MS=500
# 音声をこのミリ秒ぶん貯めてから送る
AUDIO_FLUSH_MS=100

# =====================================================================
# 感情判定(PH3)
# =====================================================================
ANGER_MODEL=gpt-4o-mini
# 直近何発話をまとめて判定するか(発話1個には感情が乗らないため)
ANGER_WINDOW=5
# この怒り度(0-100)を超えたらアラートを出す
ANGER_THRESHOLD=70
# 判定の最小間隔(秒)。連続発話でAPIを叩きすぎないためのデバウンス
ANGER_MIN_INTERVAL_SEC=3
# 音声判定の起動方針: off | threshold | interval
# 音声入力は通話時間ぶん課金されるため、既定では止めておく
VOICE_JUDGE_MODE=off
VOICE_JUDGE_INTERVAL_SEC=30

# =====================================================================
# 永続化
#   DATABASE_URL が空なら呼の記録はファイル(recordings/calls/*.json)へ
#   S3_BUCKET が空なら録音はローカルファイルへ
#   → 両方空にすればコンテナ無しで動く
# =====================================================================
DATABASE_URL=postgresql+psycopg://crossbar:crossbar-dev-secret@localhost:5433/crossbar
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=crossbar-telepath-recordings
# MinIOを使うときだけ必要(本番のS3はIAMロールなので不要)
AWS_ACCESS_KEY_ID=crossbar
AWS_SECRET_ACCESS_KEY=crossbar-dev-secret

# =====================================================================
# 開発用
# =====================================================================
# リプレイの流速。実測(323KB / 9.7秒)に合わせた既定値
REPLAY_BYTES_PER_SEC=33000
REPLAY_CHUNK_BYTES=4096
# 終了直後の呼をメモリに残す数
MAX_RECENT_CALLS=10
