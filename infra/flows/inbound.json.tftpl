{
  "Version": "2019-10-30",
  "StartAction": "SetLogging",
  "Metadata": {
    "entryPointPosition": { "x": 20, "y": 20 },
    "ActionMetadata": {
      "SetLogging": { "position": { "x": 140, "y": 20 }, "isFriendlyName": true },
      "SetVoice": { "position": { "x": 380, "y": 20 }, "isFriendlyName": true },
      "ConsentAnnouncement": { "position": { "x": 620, "y": 20 }, "isFriendlyName": true },
      "StartStreaming": { "position": { "x": 860, "y": 20 }, "isFriendlyName": true, "toCustomer": true, "fromCustomer": true },
      "NotifySCP": { "position": { "x": 1100, "y": 20 }, "isFriendlyName": true, "dynamicMetadata": {} },
      "NotifyError": { "position": { "x": 1100, "y": 380 }, "isFriendlyName": true },
      "StreamingStarted": { "position": { "x": 1340, "y": 140 }, "isFriendlyName": true },
      "Silence30s": { "position": { "x": 1580, "y": 20 }, "isFriendlyName": true },
      "PromptTick": { "position": { "x": 1580, "y": 260 }, "isFriendlyName": true },
      "SilenceLoop": { "position": { "x": 1340, "y": 20 }, "isFriendlyName": true },
      "Goodbye": { "position": { "x": 1580, "y": 20 }, "isFriendlyName": true },
      "StreamError": { "position": { "x": 860, "y": 260 }, "isFriendlyName": true },
      "Disconnect": { "position": { "x": 1820, "y": 140 }, "isFriendlyName": true }
    }
  },
  "Actions": [
    {
      "Identifier": "SetLogging",
      "Type": "UpdateFlowLoggingBehavior",
      "Parameters": { "FlowLoggingBehavior": "Enabled" },
      "Transitions": { "NextAction": "SetVoice" }
    },
    {
      "Identifier": "SetVoice",
      "Type": "UpdateContactTextToSpeechVoice",
      "Parameters": { "TextToSpeechVoice": "Takumi" },
      "Transitions": {
        "NextAction": "ConsentAnnouncement",
        "Errors": [
          { "NextAction": "Disconnect", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "ConsentAnnouncement",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "この通話は、通話品質の分析と心理状態の可視化のため、録音および解析されます。ご了承のうえ、そのままお話しください。"
      },
      "Transitions": {
        "NextAction": "StartStreaming",
        "Errors": [
          { "NextAction": "Disconnect", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "StartStreaming",
      "Type": "UpdateContactMediaStreamingBehavior",
      "Parameters": {
        "MediaStreamingState": "Enabled",
        "MediaStreamType": "Audio",
        "Participants": [
          {
            "ParticipantType": "Customer",
            "MediaDirections": ["To", "From"]
          }
        ]
      },
      "Transitions": {
        "NextAction": "NotifySCP",
        "Errors": [
          { "NextAction": "StreamError", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "NotifySCP",
      "Type": "InvokeLambdaFunction",
      "Parameters": {
        "LambdaFunctionARN": "${lambda_arn}",
        "InvocationTimeLimitSeconds": "5",
        "ResponseValidation": { "ResponseType": "STRING_MAP" }
      },
      "Transitions": {
        "NextAction": "StreamingStarted",
        "Errors": [
          { "NextAction": "NotifyError", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "NotifyError",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "解析サーバーへの通知に失敗しました。通話は継続します。"
      },
      "Transitions": {
        "NextAction": "Silence30s",
        "Errors": [
          { "NextAction": "Disconnect", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "StreamingStarted",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "解析を開始しました。ご用件をお話しください。"
      },
      "Transitions": {
        "NextAction": "Silence30s",
        "Errors": [
          { "NextAction": "Disconnect", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "Silence30s",
      "Type": "MessageParticipant",
      "Parameters": {
        "SSML": "<speak><break time=\"5000ms\"/><break time=\"5000ms\"/><break time=\"5000ms\"/><break time=\"5000ms\"/><break time=\"5000ms\"/><break time=\"5000ms\"/></speak>"
      },
      "Transitions": {
        "NextAction": "SilenceLoop",
        "Errors": [
          { "NextAction": "Disconnect", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "SilenceLoop",
      "Type": "Loop",
      "Parameters": { "LoopCount": "15" },
      "Transitions": {
        "NextAction": "Goodbye",
        "Conditions": [
          {
            "NextAction": "PromptTick",
            "Condition": { "Operator": "Equals", "Operands": ["ContinueLooping"] }
          },
          {
            "NextAction": "Goodbye",
            "Condition": { "Operator": "Equals", "Operands": ["DoneLooping"] }
          }
        ]
      }
    },
    {
      "Identifier": "PromptTick",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "はい、伺っています。続けてお話しください。"
      },
      "Transitions": {
        "NextAction": "Silence30s",
        "Errors": [
          { "NextAction": "Disconnect", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "Goodbye",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "検証時間の上限に達しました。通話を終了します。"
      },
      "Transitions": {
        "NextAction": "Disconnect",
        "Errors": [
          { "NextAction": "Disconnect", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "StreamError",
      "Type": "MessageParticipant",
      "Parameters": {
        "Text": "メディアストリーミングの開始に失敗しました。通話を終了します。"
      },
      "Transitions": {
        "NextAction": "Disconnect",
        "Errors": [
          { "NextAction": "Disconnect", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "Disconnect",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
