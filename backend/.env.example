# OpenAI APIキー(必須)。ブラウザには渡さずサーバー側だけで使う
OPENAI_API_KEY=

# 文字起こしの設定
TRANSCRIBE_MODEL=gpt-4o-transcribe
TRANSCRIBE_LANGUAGE=ja
VAD_SILENCE_MS=500

# シグナリング(SQS)監視。実通話を拾うなら 1、リプレイだけなら 0
WATCH_CALLS=0
AWS_REGION=ap-northeast-1
KVS_STREAM_PREFIX=crossbar-telepath
# 呼の設定が届くキュー。既定は "<KVS_STREAM_PREFIX>-call-events"
# CALL_EVENTS_QUEUE=crossbar-telepath-call-events
